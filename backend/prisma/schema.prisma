datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CITOYEN
  MODERATEUR
  ADMINISTRATEUR
  SUPER_ADMINISTRATEUR
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(CITOYEN)
  firstName String
  lastName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relations
  ressources         Ressource[]
  comments           Comment[]
  favorites          Favorite[]
  savedResources     SavedResource[]
  exploitedResources ExploitedResource[] // Pour le tableau de bord de progression
  participations     Participation[]     // Pour les activités/jeux
  messagesSent       Message[]           @relation("SentMessages")
  connections        ConnectionLog[]
}

model Category {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  ressources Ressource[]
}

model Ressource {
  id          Int      @id @default(autoincrement())
  title       String
  content     String?
  type        String   // VIDEO, ARTICLE, JEU, ACTIVITE
  isPublic    Boolean  @default(true)
  isValidated Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])

  // Interactions
  comments       Comment[]
  favoritedBy    Favorite[]
  savedBy        SavedResource[]
  exploitedBy    ExploitedResource[]
  viewLogs       ViewLog[]
  participations Participation[] // Les gens inscrits à cette activité
  messages       Message[]       // Le chat de groupe de cette ressource
}

model Comment {
  id          Int      @id @default(autoincrement())
  content     String
  createdAt   DateTime @default(now())
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  ressourceId Int
  ressource   Ressource @relation(fields: [ressourceId], references: [id], onDelete: Cascade)

  parentId    Int?
  parent      Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("Replies")
}

// MODIFIÉ : Message lié à une ressource pour le chat d'activité
model Message {
  id          Int       @id @default(autoincrement())
  content     String
  createdAt   DateTime  @default(now())
  senderId    Int
  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  ressourceId Int
  ressource   Ressource @relation(fields: [ressourceId], references: [id], onDelete: Cascade)
}

// NOUVEAU : Participation aux activités/jeux
model Participation {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ressourceId Int
  ressource   Ressource @relation(fields: [ressourceId], references: [id], onDelete: Cascade)
  status      String    @default("INVITED") // INVITED, ACCEPTED, DECLINED
  createdAt   DateTime  @default(now())

  @@unique([userId, ressourceId])
}

// NOUVEAU : Suivi de progression (Ressource exploitée)
model ExploitedResource {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ressourceId Int
  ressource   Ressource @relation(fields: [ressourceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, ressourceId])
}

model Favorite {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ressourceId Int
  ressource   Ressource @relation(fields: [ressourceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, ressourceId])
}

model SavedResource {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ressourceId Int
  ressource   Ressource @relation(fields: [ressourceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, ressourceId])
}

model ViewLog {
  id          Int       @id @default(autoincrement())
  ressourceId Int
  ressource   Ressource @relation(fields: [ressourceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model ConnectionLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}