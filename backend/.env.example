# ============================================================
#  Backend (NestJS) — Variables d'environnement (MODELE)
#  Copiez ce fichier en `.env` puis renseignez vos propres valeurs.
#  ⚠️ Ne committez JAMAIS le fichier `.env` : il est gitignoré.
# ============================================================

# --- Base de données PostgreSQL ---
# DATABASE_URL : connexion utilisée par l'application au runtime.
#   • LOCAL (Docker)      : base Postgres du docker-compose (port 5433).
#   • PRODUCTION (Neon)   : utilisez la chaine POOLEE (le host contient "-pooler").
DATABASE_URL="postgresql://admin:password123@localhost:5433/db_ressources?schema=public"

# DIRECT_URL : connexion DIRECTE (sans pooler), utilisee uniquement par Prisma
# pour les migrations. (Branchee au schema Prisma en Phase 4.)
#   • LOCAL             : identique a DATABASE_URL.
#   • PRODUCTION (Neon) : chaine SANS "-pooler".
DIRECT_URL="postgresql://admin:password123@localhost:5433/db_ressources?schema=public"

# --- Authentification ---
# JWT_SECRET : cle secrete de signature des tokens JWT.
# Generez une valeur robuste, ex : openssl rand -base64 32
JWT_SECRET="change_me_valeur_longue_et_aleatoire"

# --- Serveur ---
# PORT : port d'ecoute du backend (3001 par defaut).
PORT=3001

# --- Securite / CORS ---
# FRONTEND_ORIGIN : origine autorisee a appeler l'API. (Branchee en Phase 4.)
#   • LOCAL      : http://localhost:3000
#   • PRODUCTION : https://votre-frontend.vercel.app
FRONTEND_ORIGIN="http://localhost:3000"
