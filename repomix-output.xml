<file path="backend/prisma/schema.prisma">
datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")    
  }

  generator client {
    provider = "prisma-client-js"
  }

  enum Role {
    CITOYEN
    MODERATEUR
    ADMINISTRATEUR
    SUPER_ADMINISTRATEUR
  }

  model User {
    id        Int        @id @default(autoincrement())
    email     String     @unique
    password  String
    role      Role       @default(CITOYEN)
    firstName String     
    lastName  String    
    createdAt DateTime   @default(now())
    
    resources Resource[]
  }

  model Resource {
    id          Int      @id @default(autoincrement())
    title       String
    content     String?
    type        String   // Ex: VIDEO, ARTICLE, JEU
    isPublic    Boolean  @default(true)
    createdAt   DateTime @default(now())
    
    authorId    Int
    author      User     @relation(fields: [authorId], references: [id])
  }
</file>

