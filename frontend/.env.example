# ============================================================
#  Frontend (Next.js) — Variables d'environnement (MODELE)
#  Copiez ce fichier en `.env.local` puis renseignez vos valeurs.
#  ⚠️ Ne committez JAMAIS `.env.local` : il est gitignore.
# ============================================================

# --- API backend ---
# NEXT_PUBLIC_API_URL : URL de base de l'API NestJS.
# Le prefixe NEXT_PUBLIC_ l'expose au navigateur (appels fetch cote client).
# Sans slash final.
#   • LOCAL      : http://localhost:3001
#   • PRODUCTION : https://votre-backend.vercel.app
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- NextAuth ---
# NEXTAUTH_URL : URL de base du frontend.
#   • LOCAL      : http://localhost:3000
#   • PRODUCTION : https://votre-frontend.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET : secret de chiffrement des sessions NextAuth.
# Generez : openssl rand -base64 32
NEXTAUTH_SECRET="change_me_valeur_longue_et_aleatoire"
